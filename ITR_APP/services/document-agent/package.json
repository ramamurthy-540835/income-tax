{
  "name": "@taxright/document-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src tests --max-warnings=0"
  },
  "dependencies": {
    "@google-cloud/bigquery": "8.1.1",
    "@google-cloud/documentai": "9.2.0",
    "@google-cloud/firestore": "8.0.0",
    "@google-cloud/storage": "8.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vitest": "4.1.10"
  },
  "overrides": { "uuid": "11.1.1" }
}
