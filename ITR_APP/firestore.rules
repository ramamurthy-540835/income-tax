rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function role() { return signedIn() && request.auth.token.role is string ? request.auth.token.role : "CLIENT"; }
    function staff() { return role() in ["TAX_PREPARER", "AUDITOR", "ADMIN"]; }
    function ownsCase(caseId) { return signedIn() && get(/databases/$(database)/documents/cases/$(caseId)).data.owner_uid == request.auth.uid; }
    match /users/{uid} { allow read: if signedIn() && (request.auth.uid == uid || staff()); allow write: if false; }
    match /clients/{clientId} { allow read: if staff() || (signedIn() && resource.data.owner_uid == request.auth.uid); allow write: if false; }
    match /pan_index/{fingerprint} { allow read, write: if false; }
    match /cases/{caseId} {
      allow read: if staff() || (signedIn() && resource.data.owner_uid == request.auth.uid);
      allow write: if false;
      match /documents/{id} { allow read: if staff() || ownsCase(caseId); allow write: if false; }
      match /consents/{id} { allow read: if staff() || ownsCase(caseId); allow write: if false; }
      match /preferences/{id} { allow read: if staff() || ownsCase(caseId); allow write: if false; }
      match /calculations/{id} { allow read: if staff() || ownsCase(caseId); allow write: if false; }
      match /deductions/{id} { allow read: if staff() || ownsCase(caseId); allow write: if false; }
      match /reviews/{id} { allow read: if staff(); allow write: if false; }
      match /activity/{id} { allow read: if staff() || ownsCase(caseId); allow write: if false; }
    }
    match /staff/{uid} { allow read: if staff(); allow write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
